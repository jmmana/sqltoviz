<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Probe.cs;../Shared/ProbeCases.cs" />
    <ProjectReference Include="../../../packages/nuget/SqlToViz/SqlToViz.csproj" />
  </ItemGroup>

  <!-- dotnet publish -p:WithOnnx=true references SqlToViz.Onnx (to verify what happens in the browser) -->
  <ItemGroup Condition="'$(WithOnnx)' == 'true'">
    <Compile Include="../Shared/ProbeOnnx.cs" />
    <ProjectReference Include="../../../packages/nuget/SqlToViz.Onnx/SqlToViz.Onnx.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WithOnnx)' == 'true'"><DefineConstants>$(DefineConstants);WITH_ONNX</DefineConstants></PropertyGroup>

  <!-- onnxruntime-web assets and models are copied into wwwroot by tools/prepare.sh (git-ignored) -->
</Project>
