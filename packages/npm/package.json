{
  "name": "sqltoviz",
  "version": "0.1.0-alpha.1",
  "description": "Local deterministic SQL result visualization preview",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "types": "./dist/esm/node.d.ts",
      "import": "./dist/esm/node.js"
    },
    "./web": {
      "types": "./dist/esm/web.d.ts",
      "import": "./dist/esm/web.js"
    },
    "./models/*": "./models/*"
  },
  "files": [
    "dist",
    "models",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "echarts": "5.6.0",
    "onnxruntime-node": "1.31.1",
    "onnxruntime-web": "1.31.1",
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmmana/sqltoviz.git",
    "directory": "packages/npm"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "onnxruntime-node": ">=1.20",
    "onnxruntime-web": ">=1.20"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  }
}
